{
  "version": 1,
  "adapter": "csv",
  "client_id": "lipa",
  "passport": "passport.md",
  "decimal_separator": ",",
  "tables": {
    "periods": {
      "file": "periods.csv",
      "columns": {
        "client_id": "client",
        "month": "period",
        "closed": "is_closed"
      }
    },
    "reports": {
      "file": "reports-dates.csv",
      "columns": {
        "client_id": "client_id",
        "month": "month",
        "kind": "kind",
        "currency": "currency",
        "source": "source",
        "as_of": "as_of",
        "complete": "complete",
        "received_at": "received_at",
        "as_of_status": "as_of_status",
        "source_time_raw": "source_time_raw"
      }
    },
    "rows": {
      "file": "rows.csv",
      "delimiter": ";",
      "columns": {
        "client_id": "Клиент",
        "month": "Месяц",
        "kind": "Отчёт",
        "code": "Код",
        "label": "Статья",
        "dimension": "Точка",
        "amount": "Сумма",
        "status": "Статус"
      }
    },
    "notes": {
      "file": "notes.csv"
    }
  },
  "article_registry": "articles.json"
}
